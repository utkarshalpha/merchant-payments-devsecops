{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "runtimeSecret", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object", "required": ["repository", "digest", "sourceCommit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "runtimeSecret": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "imagePullSecrets": {"type": "array"}
  }
}
